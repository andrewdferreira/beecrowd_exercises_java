import java.io.IOException;
import java.util.Scanner;

public class Main {

    public static void main(String[] args) throws IOException {
        Scanner scan = new Scanner(System.in);

        int n = scan.nextInt();

        for (int j = 1; j <= 4 * n; j++) {
            if (j % 4 == 0) {
                    System.out.println("PUM");
            } else {
                    System.out.print(j + " ");
            }
        }

    }

}
