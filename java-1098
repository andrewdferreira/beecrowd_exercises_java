import java.io.IOException;

public class Main {

    public static void main(String[] args) throws IOException {
        for (float i = 0; i <= 2.1; i += 0.2f) {
            for (float j = 1 + i; j <= 3 + i; j++) {
                if (i == 0 || i == 1 || i > 2.0) {
                    System.out.printf("I=%.0f J=%.0f\n", i, j);
                } else {
                    System.out.printf("I=%.1f J=%.1f\n", i, j);
                }
            }
        }
    }

}
