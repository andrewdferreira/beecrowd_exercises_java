import java.io.IOException;
import java.util.Scanner;

public class Main {

    public static void main(String[] args) throws IOException {
        Scanner scan = new Scanner(System.in);

        int m = scan.nextInt();
        int n = scan.nextInt();
        int soma = 0;

        while (m > 0 && n > 0) {
            if (m > n) {
                for (int i = n; i <= m; i++) {
                    System.out.print(i + " ");
                    soma += i;
                }
                System.out.println("Sum=" + soma);

            } else {
                for (int i = m; i <=n; i++) {
                    System.out.print(i + " ");
                    soma += i;
                }
                System.out.println("Sum=" + soma);
            }
            m = scan.nextInt();
            n = scan.nextInt();
            soma = 0;
        }
    }

}
