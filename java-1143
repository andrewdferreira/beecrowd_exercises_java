import java.io.IOException;
import java.util.Scanner;

public class Main {

    public static void main(String[] args) throws IOException {
        Scanner scan = new Scanner(System.in);

        int n = scan.nextInt();

        for (int i = 1; i <= n; i++) {
            int valor = i;
            int quadradoDoValor = i * i;
            int cuboDoValor = i * i * i;
            System.out.println(valor + " " + quadradoDoValor + " " + cuboDoValor);
        }
    }

}
