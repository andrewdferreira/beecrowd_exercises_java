import java.io.IOException;
import java.util.Scanner;

public class Main {

    public static void main(String[] args) throws IOException {
        Scanner scan = new Scanner(System.in);

        int n = scan.nextInt();
        int nFatorial = n;

        for (int i = 1; i < n; i++) {
            nFatorial = nFatorial * (n - i);
        }
        System.out.println(nFatorial);
    }

}
