import java.io.IOException;
import java.util.Scanner;
public class Main {

    public static void main(String[] args) throws IOException {
        Scanner scan = new Scanner(System.in);

        int n = scan.nextInt();

        for (int i = 1; i <= n; i++) {
            int x = scan.nextInt();
            int y = scan.nextInt();
            int contador = 0;
            int soma = 0;

            while (contador != y) {
                if (x % 2 != 0) {
                    soma += x;
                    contador++;
                }
                x++;
            }
            System.out.println(soma);
        }
    }

}
