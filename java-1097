import java.io.IOException;

public class Main {

    public static void main(String[] args) throws IOException {
        for (int i = 1, jInicial = 7; i <= 9; i += 2, jInicial += 2) {
            for (int j = jInicial; j >= jInicial - 2; j--) {
                System.out.println("I=" + i + " J=" + j);
            }
        }
    }

}
