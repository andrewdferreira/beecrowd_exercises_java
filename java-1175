import java.io.IOException;
import java.util.Scanner;

public class Main {

    public static void main(String[] args) throws IOException {
        Scanner scan = new Scanner(System.in);

        int[] n = new int[20];
        int[] inversor = new int[20];

        for (int i = 0; i < n.length; i++) {
            n[i] = scan.nextInt();
            inversor[i] = n[i];
        }

        int incrementador = 0;
        int diminuidor = 19;

        while (true) {
            n[incrementador] = inversor[diminuidor];
            incrementador++;
            diminuidor--;
            if (incrementador > 19) {
                break;
            }
        }

        for (int i = 0; i < n.length; i++) {
            System.out.println("N[" + i + "] = " + n[i]);
        }
    }

}
