import java.io.IOException;
import java.util.Scanner;

public class Main {

    public static void main(String[] args) throws IOException {
        Scanner scan = new Scanner(System.in);

        int n = scan.nextInt();

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= 2; j++) {
                int valor = i;
                int quadradoDoValor = i * i;
                int cuboDoValor = i * i * i;

                if (j == 1) {
                    System.out.println(valor + " " + quadradoDoValor + " " + cuboDoValor);
                } else {
                    System.out.println(valor + " " + (quadradoDoValor + 1) + " " + (cuboDoValor + 1));
                }

            }
        }
    }

}
